# Copy the values below into GitHub repository secrets (NOT into any file
# in the repository).  Locally you may put them in a .env file that is
# git-ignored (see .gitignore).

# 1) From Telegram @BotFather -> /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAF...your-token-here

# 2) From Telegram @userinfobot -> copy your numeric user id.
TELEGRAM_CHAT_ID=123456789

# --- Optional tuning (defaults are sensible) ---
# ALERT_THRESHOLD=50          # alert when >= this % below new price
# HIGH_PRIORITY_THRESHOLD=70  # high-priority alert threshold (%)
# EXCEPTIONAL_THRESHOLD=90    # exceptional / likely price error (%)
# DISCOVERY_PAGES_PER_CATEGORY=2
# MAX_CANDIDATES_PER_RUN=30
# FETCH_DELAY_MIN=2.5
# FETCH_DELAY_MAX=6.0
# SUSPICIOUS_ABSOLUTE_PRICE=3000
